+void llama_model_qwen35::graph::build_layer_attn_stale(
+        llm_graph_input_attn_kv * inp,
+        ggml_tensor *             cur,
+        ggml_tensor *             inp_pos,
+        int *                     sections,
+        int                       il) {
+    const int64_t n_embd_head = hparams.n_embd_head_v();
+    const auto & layer = model.layers[il];
+
+    ggml_tensor * Kcur;
+    ggml_tensor * Vcur;
+    if (!layer.wqkv && layer.wk && layer.wv && !layer.wk_b && !layer.wv_b) {
+        Kcur = build_lora_mm(layer.wk, cur, layer.wk_s);
+        Vcur = build_lora_mm(layer.wv, cur, layer.wv_s);
+    } else {
+        auto [Qcur_full, K, V] = build_qkv(layer, cur,
+                n_embd_head * 2, n_head,
+                n_embd_head,     n_head_kv,
+                n_embd_head,     n_head_kv,
+                il, false);
+        GGML_UNUSED(Qcur_full);
+        Kcur = K;
+        Vcur = V;
+    }
+
+    Kcur = ggml_reshape_3d(ctx0, Kcur, n_embd_head, n_head_kv, n_tokens);
+    Kcur = build_norm(Kcur, layer.attn_k_norm, nullptr, LLM_NORM_RMS, il);
+    Vcur = ggml_reshape_3d(ctx0, Vcur, n_embd_head, n_head_kv, n_tokens);
+
+    Kcur = ggml_rope_multi(
+            ctx0, Kcur, inp_pos, nullptr,
+            n_rot, sections, rope_type, n_ctx_orig, freq_base, freq_scale,
+            ext_factor, attn_factor, beta_fast, beta_slow
+            );
+    cb(Kcur, "Kcur_stale", il);
+    cb(Vcur, "Vcur_stale", il);
+
+    // build_attn's cache write, without the attention
+    if (inp->self_k_rot) {
+        Kcur = llama_mul_mat_hadamard(ctx0, Kcur, inp->self_k_rot);
+    }
+    if (inp->self_v_rot) {
+        Vcur = llama_mul_mat_hadamard(ctx0, Vcur, inp->self_v_rot);
+    }
+    ggml_build_forward_expand(gf, inp->mctx->cpy_k(ctx0, Kcur, inp->get_k_idxs(), il));
+    ggml_build_forward_expand(gf, inp->mctx->cpy_v(ctx0, Vcur, inp->get_v_idxs(), il));
+}
