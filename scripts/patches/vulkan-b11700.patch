+uint32_t ggml_vk_concat_unit_size(ggml_type type);
+
+// concat.comp's tiled path (4-byte units, dim 0, src1 transposed): one 512-invocation workgroup per 16x32 dst tile.
+// Mirrors the shader's test on the push constants (nb10 != 1, nb11 == 1 in units).
+static uint32_t ggml_vk_concat_tiles(const ggml_tensor * src1, const ggml_tensor * dst) {
+    if (ggml_vk_concat_unit_size(dst->type) != 4 || ggml_is_quantized(dst->type) || dst->op_params[0] != 0 ||
+        src1->nb[0] / 4 == 1 || src1->nb[1] / 4 != 1) {
+        return 0;
+    }
+    return (uint32_t)(CEIL_DIV(dst->ne[0], 16) * CEIL_DIV(dst->ne[1], 32) * dst->ne[2] * dst->ne[3]);
+}
