@@ -5,9 +5,55 @@
 
 layout(local_size_x = 512, local_size_y = 1, local_size_z = 1) in;
 
+#ifdef CONCAT_TILED
+// dim 0 with a transposed src1 (nb10 != 1, nb11 == 1): one workgroup per 16 (i0) x 32 (i1) dst tile, loaded with i1
+// fastest (contiguous in src1) and stored with i0 fastest (contiguous in dst). The host dispatches one 512-wide row
+// of invocations per tile (ggml_vk_concat_tiled).
+shared D_TYPE ctile[16][33];
+
+void concat_tiled() {
+    const uint tile = gl_GlobalInvocationID.z * 512 + gl_GlobalInvocationID.y;
+    const uint lid = gl_LocalInvocationID.x;
+    const uint t0n = (p.ne20 + 15) / 16;
+    const uint per = t0n * ((p.ne21 + 31) / 32);
+    if (tile >= per * p.ne22 * p.ne23) {
+        return;     // the whole workgroup leaves together
+    }
+    const uint i23 = tile / per;
+    const uint r = tile - i23 * per;
+    const uint i3 = i23 / p.ne22;
+    const uint i2 = i23 - i3 * p.ne22;
+    const uint b0 = (r % t0n) * 16;
+    const uint b1 = (r / t0n) * 32;
+    {
+        const uint i0 = b0 + (lid >> 5);
+        const uint i1 = b1 + (lid & 31);
+        if (i0 < p.ne20 && i1 < p.ne21) {
+            ctile[lid >> 5][lid & 31] = i0 < p.ne00
+                ? D_TYPE(data_a[get_aoffset() + i3*p.nb03 + i2*p.nb02 + i1*p.nb01 + i0*p.nb00])
+                : D_TYPE(data_b[get_boffset() + i3*p.nb13 + i2*p.nb12 + i1*p.nb11 + (i0 - p.ne00)*p.nb10]);
+        }
+    }
+    barrier();
+    {
+        const uint i0 = b0 + (lid & 15);
+        const uint i1 = b1 + (lid >> 4);
+        if (i0 < p.ne20 && i1 < p.ne21) {
+            data_d[get_doffset() + i3*p.nb23 + i2*p.nb22 + i1*p.nb21 + i0*p.nb20] = ctile[lid & 15][lid >> 4];
+        }
+    }
+}
+#endif
